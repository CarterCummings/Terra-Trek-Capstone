<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name= "GazeboSystem" type= "system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="FL_wheel_joint">
            <command_interface name= "velocity">
                <param name="min">-50</param>
                <param name="max">50</param>

            </command_interface>
            <state_interface name= "velocity"/>
            <state_interface name= "position"/>

        </joint>
        <joint name="FR_wheel_joint">
            <command_interface name= "velocity">
                <param name="min">-50</param>
                <param name="max">50</param>

            </command_interface>
            <state_interface name= "velocity"/>
            <state_interface name= "position"/>

        </joint>
        <joint name="BL_wheel_joint">
            <command_interface name= "velocity">
                <param name="min">-50</param>
                <param name="max">50</param>

            </command_interface>
            <state_interface name= "velocity"/>
            <state_interface name= "position"/>

        </joint>
        <joint name="BR_wheel_joint">
            <command_interface name= "velocity">
                <param name="min">-50</param>
                <param name="max">50</param>

            </command_interface>
            <state_interface name= "velocity"/>
            <state_interface name= "position"/>

        </joint>

    </ros2_control>

    <gazebo>
        <plugin name="skid_steer_drive" filename="libgazebo_ros2_control.so">
            <parameters>$(find terratrek_robot)/config/my_controllers.yaml</parameters>
        </plugin>

        <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_robotiq_85_1">
            <joint>left_arm_inner_joint</joint>
            <mimicJoint>right_arm_inner_joint</mimicJoint>
            <multiplier>-1.0</multiplier>
            <offset>0.0</offset>
            <maxEffort>5.0</maxEffort>
        </plugin>            
    </gazebo>

    <transmission name="trans_extender_left">
        <type>transmission_interface/SimpleTransmission</type>
            <joint name="left_arm_outer_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
        <actuator name="motor_extender_left">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <transmission name="trans_extender_right">
        <type>transmission_interface/SimpleTransmission</type>
            <joint name="right_arm_outer_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
        <actuator name="motor_extender_right">
            <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

</robot>